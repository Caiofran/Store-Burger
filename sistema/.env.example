APP_ENV=production
APP_URL=https://delivery.seudominio.com.br
# Generate each key independently with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
DB_HOST=mysql
DB_PORT=3306
DB_NAME=brasa
DB_USER=brasa_app
DB_PASSWORD=
# Exact IP addresses of the trusted reverse proxy, comma-separated. Never use all clients.
TRUSTED_PROXIES=
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Backup credentials must be different from the application's credentials.
BACKUP_KEY=
BACKUP_DIR=/backups/brasa
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
# Set to 1 only if the chosen dump client supports --set-gtid-purged=OFF (Oracle MySQL).
MYSQL_ORACLE_CLIENT=0
